# ============================================
# KIDOU MD - Environment Variables
# ============================================
# Salin file ini jadi .env lalu isi dengan nilai aslimu.
# JANGAN PERNAH commit .env ke git (sudah ada di .gitignore).
#
#   cp .env.example .env
#
# Bot juga membaca process.env secara langsung, jadi kalau tidak mau
# pakai dotenv, bisa set manual di terminal sebelum `npm start`.
# ============================================

# --- Google API ---
# Dipakai oleh: YouTube InnerTube, Google Drive downloader, removebg (PhotoRoom auth)
GOOGLE_API_KEY=

# --- GitHub Uploader ---
# Personal Access Token dengan scope 'repo'.
# Dipakai oleh plugin tools/tools-upgh.js
GITHUB_TOKEN=
UPLOADER_USERNAME=
UPLOADER_REPO=
UPLOADER_FOLDER=
UPLOADER_BRANCH=main

# --- PhotoRoom (removebg) ---
# Refresh token dari login PhotoRoom (opsional)
PHOTOROOM_REFRESH_TOKEN=

# --- Payment (Pakasir) ---
PAKASIR_SLUG=
PAKASIR_APIKEY=

# --- Group ---
# Dikosongkan kalau belum dipakai. Plugin owner/owner-backup.js akan
# memberi tahu kalau backupGroup kosong, jadi tidak ada JID palsu.
/* OFFICIAL_GROUP=https://chat.whatsapp.com/xxxxxx
BACKUP_GROUP=1234567890@g.us */

# --- Panel (opsional) ---
# Dipakai oleh plugins/owner/cpanel.js. Kalau kosong, plugin akan
# memberi tahu "Panel belum disetting".
/* PANEL_DOMAIN=https://panel.example.com
PANEL_PTLA=
PANEL_PTLC= */

# --- Cloudinary (ai-upscaler) ---
# Credential Cloudinary milik sendiri. Kalau kosong, plugin akan
# memberi tahu, bukan diam-diam memakai akun orang lain.
/* CLOUDINARY_API_KEY=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_UPLOAD_API=https://api.cloudinary.com/v1_1/<cloud_name>/auto/upload */
